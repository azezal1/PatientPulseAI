{
  "name": "patientpulse-ai",
  "version": "1.0.0",
  "description": "AI-Powered Zero-Latency Medical Triage System for Indian Emergency Rooms",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
